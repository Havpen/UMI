# Пароль страницы /admin (только локально / на Node-сервере, не GitHub Pages).
ADMIN_PASSWORD=

# Гостевой сайт на GitHub Pages: https://havpen.github.io/UMI/
# Админка и Telegram-бот туда не входят.

